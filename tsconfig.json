{
  "compilerOptions": {
    // 语言和环境
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",

    // 输出配置
    "outDir": "./dist",
    "rootDir": "./",
    "removeComments": true,
    "sourceMap": true,

    // 类型检查
    "strict": false,  // 渐进式迁移，先不开启严格模式
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": true,

    // 额外检查
    "noUnusedLocals": false,  // 渐进式迁移，暂不检查
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,

    // 模块解析
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,  // 允许编译 JS 文件
    "checkJs": false,  // 不检查 JS 文件（渐进式迁移）

    // 其他
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,

    // 路径映射
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"],
      "@config/*": ["config/*"],
      "@controllers/*": ["controllers/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"]
    },

    // 实验性功能
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },

  // 包含的文件
  "include": [
    "**/*.ts",
    "**/*.js",
    "types/**/*.d.ts"
  ],

  // 排除的文件
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "logs",
    ".venv",
    "Neuro_Live2D_Module",
    "vibevoice-python",
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.spec.ts",
    "**/*.spec.js"
  ],

  // TypeScript 项目引用
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
