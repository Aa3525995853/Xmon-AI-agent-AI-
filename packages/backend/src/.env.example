# 环境变量模板文件
# 复制此文件为 .env 并填入实际的 API 密钥

# ==================== LLM API 配置 =================

# Kimi API 配置（高难度任务使用）
KIMI_API_KEY=your-kimi-api-key-here
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k

# Mimo API 配置（文本输出优先使用）
MIMO_API_KEY=your-mimo-api-key-here
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5

# ==================== 工作流/Coding Agent 配置 =================
# 火山引擎 Coding Agent（按任务难度自动选择）

WORKFLOW_API_KEY=your-volcano-api-key-here
WORKFLOW_API_URL=https://ark.cn-beijing.volces.com/api/coding/v3/chat/completions
# 可选 Agent: deepseek-v4-pro | doubao-seed-2.0-pro | deepseek-v4-flash | doubao-seed-2.0-code | kimi-k2.6 | glm-5.1
WORKFLOW_MODEL=deepseek-v4-pro

# =============== TTS 配置 ============

# TTS 提供商：mimo | volcano | minimax | edge | mock
TTS_PROVIDER=mimo

# MiMo TTS API 配置
MIMO_TTS_API_KEY=your-mimo-tts-api-key-here
MIMO_TTS_API_URL=https://token-plan-cn.xiaomimimo.com/v1

# ================ 应用配置 ==============

# 运行环境：development | production
NODE_ENV=production

# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# 人格模式：gentle（温柔可爱） | tsundere（毒舌傲娇但温柔）
PERSONA_MODE=gentle

# 配置验证：true | false
VALIDATE_CONFIG=true

# ================= 可选：高级配置 ====================

# Redis 缓存配置（可选，未配置时使用内存缓存降级）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# LLM 配置
# LLM_TEMPERATURE=0.85
# LLM_TOP_P=0.95
# LLM_STREAM_TIMEOUT=120000        # 流式响应超时 120 秒（长回答需要较长超时）
# LLM_TIMEOUT_MIMO=60000           # MiMo 模型超时 60 秒
# LLM_TIMEOUT_DEFAULT=60000        # 其他模型超时 60 秒

# 句子处理
# SENTENCE_MAX_LENGTH=50
# SENTENCE_MIN_LENGTH=2
# SENTENCE_MERGE_THRESHOLD=30

# 背压控制
# STREAM_HIGH_WATER_MARK=131072
# STREAM_LOW_WATER_MARK=32768
# STREAM_MAX_QUEUE_SIZE=200

# 聊天配置
# CHAT_DEFAULT_EMOTION=calm
# CHAT_DEFAULT_SPEECH_RATE=0.9
# CHAT_DEFAULT_VOLUME=0.7
# PENDING_COMMAND_TIMEOUT=60000

# TTS 配置
# TTS_SAMPLE_RATE=24000
# TTS_FORMAT=pcm16
# TTS_CHUNK_SIZE=4800
# TTS_DEFAULT_EMOTION=neutral

# 对话历史
# CONVERSATION_MAX_HISTORY=6

# ==================== OpenClaw Agent 配置 =================

# OpenClaw Gateway 地址（默认本地安装）
OPENCLAW_URL=http://localhost:18789

# OpenClaw API 认证 Token（在 openclaw.json 中配置）
OPENCLAW_AUTH_TOKEN=

# OpenClaw Agent ID（默认 main）
OPENCLAW_AGENT_ID=main
