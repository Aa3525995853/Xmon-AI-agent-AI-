{
  "name": "@xiaomeng/backend",
  "version": "1.0.0",
  "description": "小梦后端服务 - Express + Node.js",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/start-all.js",
    "start": "node src/server.js",
    "start:utf8": "powershell -Command \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; node src/start-all.js\"",
    "build": "node src/verify-backend.js",
    "test": "jest --config src/jest.config.js",
    "test:watch": "jest --watch --config src/jest.config.js",
    "test:coverage": "jest --coverage --config src/jest.config.js",
    "test:unit": "jest --testPathPattern=src/tests/unit --config src/jest.config.js",
    "test:integration": "jest --testPathPattern=src/tests/integration --config src/jest.config.js",
    "pm2:start": "pm2 start src/ecosystem.config.js",
    "pm2:stop": "pm2 stop src/ecosystem.config.js",
    "pm2:restart": "pm2 restart src/ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "lint": "node ../../scripts/lint.js",
    "clean": "rimraf node_modules"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xiaomeng/shared": "workspace:*",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "pm2": "^5.3.0",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.3"
  }
}
